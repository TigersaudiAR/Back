# Quran API Configuration
# King Fahd Complex for Printing the Holy Quran - Official API
# Default: https://qurancomplex.gov.sa/quran-dev/
VITE_QURAN_BASE=https://qurancomplex.gov.sa/quran-dev/

# Optional: API Key for King Fahd Complex API (if required)
# Leave empty if not needed
VITE_QURAN_API_KEY=

# Optional: Netlify Function proxy URL
# Use this to proxy requests through Netlify Functions for CORS support
# Example: /.netlify/functions/quran-proxy
VITE_QURAN_PROXY=

# Backend API URL (for other features)
VITE_API_URL=http://localhost:4000
