# Quran API Configuration
# Base URL for King Fahd Complex Quran API
VITE_QURAN_BASE=https://qurancomplex.gov.sa/quran-dev/

# Optional: API Key for King Fahd Complex (if required)
# DO NOT commit actual keys to the repository
VITE_QURAN_API_KEY=

# Optional: Proxy endpoint for Quran API requests
# Use Netlify Functions proxy for CORS and security
VITE_QURAN_PROXY=/.netlify/functions/quran-proxy

# Cache TTL in milliseconds (default: 1 hour = 3600000ms)
VITE_CACHE_TTL=3600000
