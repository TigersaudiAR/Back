# Backend API URL
VITE_API_URL=http://localhost:4000

# Quran API Configuration
# King Fahd Complex API Base URL (المصدر الرسمي: مجمع الملك فهد لطباعة المصحف الشريف)
VITE_QURAN_BASE=https://qurancomplex.gov.sa/quran-dev

# Optional: API Key for King Fahd Complex (if required)
# Do NOT commit actual API keys to the repository
VITE_QURAN_API_KEY=

# Optional: Use Netlify proxy for API calls
# Set this when deploying to Netlify Functions
VITE_QURAN_PROXY=/.netlify/functions/quran-proxy

# Cache TTL in milliseconds (default: 1 hour = 3600000 ms)
# Adjust based on your needs for data freshness vs. performance
VITE_CACHE_TTL=3600000
