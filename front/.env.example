# Client-side Environment Variables (Vite)
# These are exposed to the browser and bundled into the build

# Backend API URL (if using a separate backend)
VITE_API_URL=http://localhost:4000

# Quran API Configuration
# Base URL for King Fahd Complex Quran API
VITE_QURAN_BASE=https://qurancomplex.gov.sa/quran-dev

# Optional API key for King Fahd Complex API
VITE_QURAN_API_KEY=

# Optional Netlify Function proxy URL (use this to avoid CORS issues)
# When deployed: /.netlify/functions/quran-proxy
# When local dev with netlify CLI: http://localhost:8888/.netlify/functions/quran-proxy
VITE_QURAN_PROXY=

# Server-side Environment Variables (Netlify Functions)
# These are NOT exposed to the browser
# Set these in Netlify Dashboard > Site settings > Environment variables

# QURAN_BASE - Same as VITE_QURAN_BASE but for Functions
# QURAN_API_KEY - Same as VITE_QURAN_API_KEY but for Functions
